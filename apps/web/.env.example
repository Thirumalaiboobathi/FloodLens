# Copy to .env.local (gitignored). Build-time values are embedded in the public bundle: never put an
# AWS access key, secret or session token here. Only a restricted Amazon Location *browser API key*.

# Same-origin API in production (CloudFront routes /v1 to API Gateway); leave empty in development.
# VITE_API_BASE=

# Basemap, option 1: a full style URL (wins over option 2).
# VITE_MAP_STYLE_URL=

# Basemap, option 2: Amazon Location Service Maps v2 (maps.geo.<region>.amazonaws.com).
# The key is a referrer-restricted, maps-only key (v1.public...). Do not commit a real one.
# VITE_LOCATION_API_KEY=
# VITE_LOCATION_REGION=ap-south-1
# VITE_LOCATION_STYLE=Monochrome        # Standard | Monochrome | Hybrid | Satellite
# VITE_LOCATION_COLOR_SCHEME=Light      # Light | Dark (Standard and Monochrome only)
# VITE_LOCATION_POLITICAL_VIEW=IND      # ISO country code; empty string disables
