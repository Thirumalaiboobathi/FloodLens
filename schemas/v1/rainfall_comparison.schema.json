      "title": "Caution",
      "type": "string"
    },
    "disclaimer": {
      "default": "Satellite-estimated rainfall accumulation (NASA GPM IMERG) on a ~10 km grid over a stated UTC period. Not flood depth, not a forecast, not an official warning, not a rain-gauge measurement, and not part of the exposure index.",
      "title": "Disclaimer",
      "type": "string"
    },
    "exposure_note": {
      "default": "Observed rainfall is not an input of the exposure index. Exposure results exist only for the terrain baseline and hypothetical scenarios.",
      "title": "Exposure Note",
      "type": "string"
    },
