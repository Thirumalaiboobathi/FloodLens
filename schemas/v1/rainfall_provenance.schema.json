{
  "$defs": {
    "GranuleRef": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "product_version": {
          "title": "Product Version",
          "type": "string"
        }
      },
      "required": [
        "file",
        "date",
        "product_version"
      ],
      "title": "GranuleRef",
      "type": "object"
    },
    "RainfallStream": {
      "enum": [
        "historical_final",
        "recent_late"
      ],
      "title": "RainfallStream",
      "type": "string"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        }
      },
      "required": [
        "provider",
        "source_url",
        "attribution",
        "license"
      ],
      "title": "SourceInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "derived_dataset_id": {
      "title": "Derived Dataset Id",
      "type": "string"
    },
    "disclaimer": {
      "default": "Satellite-estimated rainfall accumulation (NASA GPM IMERG) on a ~10 km grid over a stated UTC period. Not flood depth, not a forecast, not an official warning, not a rain-gauge measurement, and not part of the exposure index.",
      "title": "Disclaimer",
      "type": "string"
    },
    "granules": {
      "items": {
        "$ref": "#/$defs/GranuleRef"
      },
      "title": "Granules",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "processed_sha256": {
      "title": "Processed Sha256",
      "type": "string"
    },
    "processing": {
      "items": {
        "type": "string"
      },
      "title": "Processing",
      "type": "array"
    },
    "product_identifier": {
      "title": "Product Identifier",
      "type": "string"
    },
    "product_versions": {
      "items": {
        "type": "string"
      },
      "title": "Product Versions",
      "type": "array"
    },
    "rainfall_stream": {
      "$ref": "#/$defs/RainfallStream"
    },
    "raw_dataset_id": {
      "title": "Raw Dataset Id",
      "type": "string"
    },
    "raw_verification": {
      "enum": [
        "verified",
        "partial",
        "not_present"
      ],
      "title": "Raw Verification",
      "type": "string"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "retrieval_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieval Timestamp"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "region_id",
    "rainfall_stream",
    "product_identifier",
    "product_versions",
    "derived_dataset_id",
    "raw_dataset_id",
    "raw_verification",
    "processed_sha256",
    "retrieval_timestamp",
    "source",
    "granules",
    "processing",
    "limitations",
    "warnings"
  ],
  "title": "RainfallProvenance",
  "type": "object"
}
