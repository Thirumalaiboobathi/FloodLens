{
  "$defs": {
    "RainfallStream": {
      "enum": [
        "historical_final",
        "recent_late"
      ],
      "title": "RainfallStream",
      "type": "string"
    },
    "ScenarioCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "enum": [
            "terrain_baseline",
            "hypothetical_rainfall",
            "historical_observed",
            "recent_observed"
          ],
          "title": "Group",
          "type": "string"
        },
        "has_exposure_outputs": {
          "title": "Has Exposure Outputs",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "observation_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation End"
        },
        "observation_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Start"
        },
        "rainfall_accumulation_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rainfall Accumulation Mm"
        },
        "rainfall_stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/RainfallStream"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_type": {
          "$ref": "#/$defs/ScenarioType"
        }
      },
      "required": [
        "scenario_id",
        "scenario_type",
        "group",
        "label",
        "has_exposure_outputs"
      ],
      "title": "ScenarioCatalogEntry",
      "type": "object"
    },
    "ScenarioType": {
      "description": "What forces a scenario. These three must never be conflated.",
      "enum": [
        "terrain_baseline",
        "hypothetical_rainfall_accumulation",
        "observed_rainfall"
      ],
      "title": "ScenarioType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "note": {
      "default": "Observed rainfall scenarios are context layers: they have no exposure outputs and do not enter the exposure index.",
      "title": "Note",
      "type": "string"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioCatalogEntry"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "region_id",
    "scenarios"
  ],
  "title": "ScenarioCatalog",
  "type": "object"
}
