{
  "$defs": {
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "description": "Whole UTC days between observation end and as_of_utc",
          "title": "Age Days",
          "type": "integer"
        },
        "as_of_utc": {
          "format": "date-time",
          "title": "As Of Utc",
          "type": "string"
        },
        "is_live": {
          "const": false,
          "default": false,
          "title": "Is Live",
          "type": "boolean"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "observation_end": {
          "format": "date",
          "title": "Observation End",
          "type": "string"
        },
        "status": {
          "enum": [
            "historical_archive",
            "recent_provisional",
            "aged_provisional"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "as_of_utc",
        "observation_end",
        "age_days",
        "note"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "FreshnessEntry": {
      "additionalProperties": false,
      "properties": {
        "data_freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "rainfall_stream": {
          "$ref": "#/$defs/RainfallStream"
        },
        "retrieval_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Timestamp"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "rainfall_stream",
        "retrieval_timestamp",
        "data_freshness"
      ],
      "title": "FreshnessEntry",
      "type": "object"
    },
    "RainfallStream": {
      "enum": [
        "historical_final",
        "recent_late"
      ],
      "title": "RainfallStream",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_utc": {
      "format": "date-time",
      "title": "As Of Utc",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/FreshnessEntry"
      },
      "title": "Datasets",
      "type": "array"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "region_id",
    "as_of_utc",
    "datasets"
  ],
  "title": "RainfallFreshness",
  "type": "object"
}
