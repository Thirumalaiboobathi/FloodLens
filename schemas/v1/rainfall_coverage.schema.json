{
  "$defs": {
    "CoveragePeriod": {
      "additionalProperties": false,
      "properties": {
        "n_days": {
          "title": "N Days",
          "type": "integer"
        },
        "observation_end": {
          "format": "date",
          "title": "Observation End",
          "type": "string"
        },
        "observation_start": {
          "format": "date",
          "title": "Observation Start",
          "type": "string"
        },
        "product_version": {
          "title": "Product Version",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "observation_start",
        "observation_end",
        "n_days",
        "product_version"
      ],
      "title": "CoveragePeriod",
      "type": "object"
    },
    "RainfallStream": {
      "enum": [
        "historical_final",
        "recent_late"
      ],
      "title": "RainfallStream",
      "type": "string"
    },
    "StreamCoverage": {
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Earliest"
        },
        "latest": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/CoveragePeriod"
          },
          "title": "Periods",
          "type": "array"
        },
        "status": {
          "enum": [
            "available",
            "pending",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "stream": {
          "$ref": "#/$defs/RainfallStream"
        }
      },
      "required": [
        "stream",
        "status",
        "periods",
        "earliest",
        "latest"
      ],
      "title": "StreamCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "note": {
      "default": "Streams are never merged. The same calendar dates may appear in both, as different estimates; Late Run is provisional and not interchangeable with Final.",
      "title": "Note",
      "type": "string"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/StreamCoverage"
      },
      "title": "Streams",
      "type": "array"
    }
  },
  "required": [
    "region_id",
    "streams"
  ],
  "title": "RainfallCoverage",
  "type": "object"
}
